# The site is a static export — it has no server and no runtime secrets.
# Nothing here is required to run or build; copy to .env.local only if you
# want analytics locally.
#
# Anything set here is read at BUILD time and inlined into the generated
# HTML. Never put a secret in this file.

# ─── Analytics (optional) ────────────────────────────────────────────
# Plausible site domain, e.g. tinytrauma.com. Leave empty to omit the
# analytics script entirely.
PLAUSIBLE_DOMAIN=

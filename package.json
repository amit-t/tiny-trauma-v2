{
  "name": "tiny-trauma-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "preview": "python3 -m http.server 3000 --directory out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "content": "velite build --strict",
    "content:watch": "velite dev",
    "test": "vitest",
    "test:visuals": "tests/visuals/run-all.zsh",
    "mcp:install-browsers": "playwright install chromium"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "velite": "^0.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/mcp": "latest",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.9.0",
    "playwright": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^4.1.6"
  }
